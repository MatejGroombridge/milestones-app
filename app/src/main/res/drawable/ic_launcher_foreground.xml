<?xml version="1.0" encoding="utf-8"?>
<!--
    Milestones launcher icon foreground: three ascending bars with a star
    crowning the tallest — "each one beats the last".

    Geometry: bars sit between y=42 and y=78 across x=30..78, and the star is
    centred at (71.5, 31) with an 8-unit outer radius. Everything lands inside
    the 18..90 safe region of the 108x108 adaptive-icon viewport, so OEM
    icon-shape masks (circle, squircle, teardrop, etc.) won't clip into it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shortest bar -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M33,62 h7 a3,3 0 0 1 3,3 v10 a3,3 0 0 1 -3,3 h-7 a3,3 0 0 1 -3,-3 v-10 a3,3 0 0 1 3,-3 z" />

    <!-- Middle bar -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M50.5,52 h7 a3,3 0 0 1 3,3 v20 a3,3 0 0 1 -3,3 h-7 a3,3 0 0 1 -3,-3 v-20 a3,3 0 0 1 3,-3 z" />

    <!-- Tallest bar -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M68,42 h7 a3,3 0 0 1 3,3 v30 a3,3 0 0 1 -3,3 h-7 a3,3 0 0 1 -3,-3 v-30 a3,3 0 0 1 3,-3 z" />

    <!-- Star above the tallest bar -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M71.5,23 L73.3,28.52 L79.11,28.53 L74.41,31.95 L76.2,37.47 L71.5,34.06 L66.8,37.47 L68.59,31.95 L63.89,28.53 L69.7,28.52 Z" />
</vector>
